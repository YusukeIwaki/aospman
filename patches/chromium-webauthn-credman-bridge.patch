+        WebauthnCredManBridge.onCredManConditionalRequestPending(
+                frameHost,
+                hasResults,
+                requestPasswords -> {
+                    mCallbackCount++;
+                    mRequestPasswords = requestPasswords;
+                });
+    }
+
+    @CalledByNative
+    public void onCredManUiClosed(@Nullable RenderFrameHost frameHost, boolean success) {
+        WebauthnCredManBridge.onCredManUiClosed(frameHost, success);
