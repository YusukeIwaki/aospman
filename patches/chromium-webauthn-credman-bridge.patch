+  base::MockOnceClosure next_notification;
+  EXPECT_CALL(next_notification, Run()).Times(0);
+  delegate()->RequestNotificationWhenCredentialsReady(next_notification.Get());
+  testing::Mock::VerifyAndClearExpectations(&next_notification);
+
+  EXPECT_CALL(next_notification, Run());
+  delegate()->OnCredManConditionalRequestPending(false, show_ui.Get());
+}
