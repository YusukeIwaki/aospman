+  EXPECT_CALL(completion, Run(testing::_)).Times(0);
+  delegate()->FillUsernameAndPassword(u"username", u"password");
+
+  // The pending passkey request survives, but another password fill needs a new
+  // callback.
+  EXPECT_CALL(show_ui, Run(false));
+  delegate()->TriggerCredManUi(WebAuthnCredManDelegate::RequestPasswords(true));
+}
