+
+    @CalledByNative
+    public void onPasswordCredentialReceived(
+            @Nullable RenderFrameHost frameHost, String username, String password) {
+        WebauthnCredManBridge.onPasswordCredentialReceived(frameHost, username, password);
+    }
+
+    @CalledByNative
+    public void cleanupCredManRequest(@Nullable RenderFrameHost frameHost) {
+        WebauthnCredManBridge.cleanupCredManRequest(frameHost);
+    }
+
+    @CalledByNative
+    public int getCallbackCount() {
+        return mCallbackCount;
+    }
+
+    @CalledByNative
+    public boolean getRequestPasswords() {
+        return mRequestPasswords;
+    }
+}
