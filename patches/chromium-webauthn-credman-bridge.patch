+#include "components/webauthn/android/native_j_unittests_jni_headers/WebauthnCredManBridgeTestHelper_jni.h"
+
+namespace webauthn {
+
+class WebAuthnCredManBridgeTest : public content::RenderViewHostTestHarness {
+ public:
+  void SetUp() override {
+    content::RenderViewHostTestHarness::SetUp();
+    WebAuthnClientAndroid::SetClient(
+        std::make_unique<StubWebAuthnClientAndroid>());
+    helper_.Reset(Java_WebauthnCredManBridgeTestHelper_create(env()));
+  }
+
+  void TearDown() override {
+    helper_.Reset();
+    WebAuthnClientAndroid::ClearClientForTesting();
+    content::RenderViewHostTestHarness::TearDown();
+  }
+
+  JNIEnv* env() { return base::android::AttachCurrentThread(); }
+
+  content::RenderFrameHost* LiveMainFrame() {
+    auto* frame = web_contents()->GetPrimaryMainFrame();
+    content::RenderFrameHostTester::For(frame)->InitializeRenderFrameIfNeeded();
+    return frame;
+  }
+
+  WebAuthnCredManDelegateFactory* factory() {
+    return WebAuthnCredManDelegateFactory::GetFactory(web_contents());
+  }
+
+  void SendPending(const base::android::JavaRef<jobject>& frame,
+                   bool has_results) {
+    Java_WebauthnCredManBridgeTestHelper_onCredManConditionalRequestPending(
+        env(), helper_, frame, has_results);
+  }
+
+  int CallbackCount() {
+    return Java_WebauthnCredManBridgeTestHelper_getCallbackCount(env(),
+                                                                 helper_);
+  }
+
+  // Exercise every entry point with a frame that must no longer be usable.
+  void SendIgnoredEvents(const base::android::JavaRef<jobject>& frame) {
+    SendPending(frame, false);
+    Java_WebauthnCredManBridgeTestHelper_onCredManUiClosed(env(), helper_,
+                                                           frame, false);
+    Java_WebauthnCredManBridgeTestHelper_onPasswordCredentialReceived(
+        env(), helper_, frame,
+        base::android::ConvertUTF16ToJavaString(env(), u"old username"),
+        base::android::ConvertUTF16ToJavaString(env(), u"old password"));
+    Java_WebauthnCredManBridgeTestHelper_cleanupCredManRequest(env(), helper_,
+                                                               frame);
+  }
+
+ protected:
+  base::android::ScopedJavaGlobalRef<jobject> helper_;
+};
+
+TEST_F(WebAuthnCredManBridgeTest, PendingAndCleanupRoundTrip) {
+  auto* frame = LiveMainFrame();
+  auto java_frame = frame->GetJavaRenderFrameHost();
+  auto* delegate = factory()->GetRequestDelegate(frame);
+  ASSERT_NE(delegate, nullptr);
+  base::MockCallback<
+      base::OnceCallback<void(const std::u16string&, const std::u16string&)>>
+      filling;
+  EXPECT_CALL(filling, Run(testing::_, testing::_)).Times(0);
+  delegate->SetFillingCallback(filling.Get());
+
+  SendPending(java_frame, false);
+  EXPECT_EQ(delegate->HasPasskeys(), WebAuthnCredManDelegate::kNoPasskeys);
+  EXPECT_EQ(CallbackCount(), 0);
+  delegate->TriggerCredManUi(WebAuthnCredManDelegate::RequestPasswords(false));
+  EXPECT_EQ(CallbackCount(), 1);
+  EXPECT_FALSE(
+      Java_WebauthnCredManBridgeTestHelper_getRequestPasswords(env(), helper_));
+
+  SendPending(java_frame, true);
+  EXPECT_EQ(delegate->HasPasskeys(), WebAuthnCredManDelegate::kHasPasskeys);
+  delegate->TriggerCredManUi(WebAuthnCredManDelegate::RequestPasswords(true));
+  EXPECT_EQ(CallbackCount(), 2);
+  EXPECT_TRUE(
+      Java_WebauthnCredManBridgeTestHelper_getRequestPasswords(env(), helper_));
+
+  Java_WebauthnCredManBridgeTestHelper_cleanupCredManRequest(env(), helper_,
+                                                             java_frame);
+  EXPECT_EQ(delegate->HasPasskeys(), WebAuthnCredManDelegate::kNotReady);
+  delegate->TriggerCredManUi(WebAuthnCredManDelegate::RequestPasswords(false));
+  EXPECT_EQ(CallbackCount(), 2);
+}
+
+TEST_F(WebAuthnCredManBridgeTest, UiClosedForwardsSuccessAndFailure) {
+  auto* frame = LiveMainFrame();
+  auto* delegate = factory()->GetRequestDelegate(frame);
+  ASSERT_NE(delegate, nullptr);
+  base::MockCallback<base::RepeatingCallback<void(bool)>> completion;
+  delegate->SetRequestCompletionCallback(completion.Get());
+  testing::InSequence sequence;
