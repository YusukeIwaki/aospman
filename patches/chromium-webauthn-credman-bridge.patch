+  EXPECT_CALL(filling, Run(testing::_, testing::_)).Times(0);
+  SendPending(new_child->GetJavaRenderFrameHost(), true);
+
+  SendIgnoredEvents(old_java_frame);
+
+  EXPECT_EQ(new_delegate->HasPasskeys(), WebAuthnCredManDelegate::kHasPasskeys);
+  EXPECT_EQ(CallbackCount(), 0);
+  new_delegate->TriggerCredManUi(
+      WebAuthnCredManDelegate::RequestPasswords(false));
+  EXPECT_EQ(CallbackCount(), 1);
+}
