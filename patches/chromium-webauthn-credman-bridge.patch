@@ -0,0 +1,107 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <jni.h>
+
+#include "base/android/callback_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "components/webauthn/android/webauthn_cred_man_delegate.h"
+#include "components/webauthn/android/webauthn_cred_man_delegate_factory.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "components/webauthn/android/jni_headers/WebauthnCredManBridge_jni.h"
+
+namespace webauthn {
+
+namespace {
+
+content::RenderFrameHost* GetLiveRenderFrameHost(
+    const base::android::JavaRef<jobject>& jframe_host) {
+  auto* render_frame_host =
+      content::RenderFrameHost::FromJavaRenderFrameHost(jframe_host);
+  if (!render_frame_host ||
+      !content::WebContents::FromRenderFrameHost(render_frame_host)) {
+    return nullptr;
+  }
+  return render_frame_host;
+}
+
+WebAuthnCredManDelegate* GetCredManDelegate(
+    const base::android::JavaRef<jobject>& jframe_host) {
+  auto* render_frame_host = GetLiveRenderFrameHost(jframe_host);
+  if (!render_frame_host) {
+    return nullptr;
+  }
+  auto* factory = WebAuthnCredManDelegateFactory::GetFactory(
+      content::WebContents::FromRenderFrameHost(render_frame_host));
+  return factory->GetRequestDelegate(render_frame_host);
+}
+
+void TriggerFullRequest(
+    const base::android::JavaRef<jobject>& jfull_request_callback,
+    bool request_passwords) {
+  base::android::RunBooleanCallbackAndroid(jfull_request_callback,
+                                           request_passwords);
+}
+
+void JNI_WebauthnCredManBridge_OnCredManConditionalRequestPending(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jframe_host,
+    bool has_results,
+    const base::android::JavaRef<jobject>& jfull_request_callback) {
+  auto* delegate = GetCredManDelegate(jframe_host);
+  if (!delegate) {
+    return;
+  }
+  delegate->OnCredManConditionalRequestPending(
+      has_results,
+      base::BindRepeating(&TriggerFullRequest,
+                          base::android::ScopedJavaGlobalRef<jobject>(
+                              env, jfull_request_callback)));
+}
+
+void JNI_WebauthnCredManBridge_OnCredManUiClosed(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jframe_host,
+    bool success) {
+  auto* delegate = GetCredManDelegate(jframe_host);
+  if (!delegate) {
+    return;
+  }
+  delegate->OnCredManUiClosed(success);
+}
+
+void JNI_WebauthnCredManBridge_OnPasswordCredentialReceived(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jframe_host,
+    const base::android::JavaRef<jstring>& jusername,
+    const base::android::JavaRef<jstring>& jpassword) {
+  auto* delegate = GetCredManDelegate(jframe_host);
+  if (!delegate) {
+    return;
+  }
+  delegate->FillUsernameAndPassword(
+      base::android::ConvertJavaStringToUTF16(env, jusername),
+      base::android::ConvertJavaStringToUTF16(env, jpassword));
+}
+
+void JNI_WebauthnCredManBridge_CleanupCredManRequest(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jframe_host) {
+  auto* delegate = GetCredManDelegate(jframe_host);
+  if (!delegate) {
+    return;
+  }
+  delegate->CleanUpConditionalRequest();
+}
+
+}  // namespace
+
+}  // namespace webauthn
+
+DEFINE_JNI(WebauthnCredManBridge)
