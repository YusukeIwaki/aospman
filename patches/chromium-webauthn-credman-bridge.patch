+TEST_F(WebAuthnCredManDelegateTest, CredentialsReadyNotificationAfterCleanup) {
+  base::MockCallback<base::RepeatingCallback<void(bool)>> show_ui;
+  base::MockOnceClosure first_notification;
+  delegate()->RequestNotificationWhenCredentialsReady(first_notification.Get());
+  EXPECT_CALL(first_notification, Run());
+  delegate()->OnCredManConditionalRequestPending(true, show_ui.Get());
+  delegate()->CleanUpConditionalRequest();
