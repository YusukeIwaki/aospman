+
+/** Calls the real Java/JNI bridge from WebAuthnCredManBridgeTest. */
+@NullMarked
+public class WebauthnCredManBridgeTestHelper {
+    private int mCallbackCount;
+    private boolean mRequestPasswords;
+
+    @CalledByNative
+    public static WebauthnCredManBridgeTestHelper create() {
+        return new WebauthnCredManBridgeTestHelper();
