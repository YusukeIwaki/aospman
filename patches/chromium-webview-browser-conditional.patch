+// found in the LICENSE file.
+
+#ifndef ANDROID_WEBVIEW_BROWSER_AW_WEBAUTHN_CLIENT_ANDROID_H_
+#define ANDROID_WEBVIEW_BROWSER_AW_WEBAUTHN_CLIENT_ANDROID_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "components/webauthn/android/webauthn_client_android.h"
+
+namespace content {
+class RenderFrameHost;
+}
+
+namespace device {
+class DiscoverableCredentialMetadata;
+}
+
+namespace android_webview {
+
+// Installs the generic WebAuthn client hooks needed by WebView's Android
+// Autofill provider. WebView does not provide Chrome's custom credential UI;
+// conditional Credential Manager requests are surfaced by Android Autofill.
+class AwWebAuthnClientAndroid : public webauthn::WebAuthnClientAndroid {
+ public:
+  ~AwWebAuthnClientAndroid() override;
+
+  void OnWebAuthnRequestPending(
+      content::RenderFrameHost* frame_host,
+      std::vector<device::DiscoverableCredentialMetadata> credentials,
+      webauthn::AssertionMediationType mediation_type,
+      base::RepeatingCallback<void(const std::vector<uint8_t>& id)>
+          passkey_callback,
+      base::RepeatingCallback<void(std::u16string_view, std::u16string_view)>
+          password_callback,
+      base::RepeatingClosure hybrid_closure,
+      base::RepeatingCallback<void(webauthn::NonCredentialReturnReason)>
+          non_credential_callback) override;
+  void CleanupWebAuthnRequest(content::RenderFrameHost* frame_host) override;
+  bool ShouldDisallowCredentialRequest(
+      content::RenderFrameHost* render_frame_host) override;
+};
+
+}  // namespace android_webview
+
+#endif  // ANDROID_WEBVIEW_BROWSER_AW_WEBAUTHN_CLIENT_ANDROID_H_
