@@ -0,0 +1,78 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.components.webauthn;
+
+import static org.chromium.components.webauthn.WebauthnLogger.log;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.RenderFrameHost;
+
+/**
+ * Routes Credential Manager lifecycle events to the embedding browser.
+ *
+ * <p>Unlike {@link WebauthnBrowserBridge}, this bridge does not expose Chrome's custom credential
+ * picker. It is shared by Chrome and WebView embedders that integrate conditional Credential
+ * Manager requests with Android Autofill.
+ */
+@JNINamespace("webauthn")
+@NullMarked
+public class WebauthnCredManBridge {
+    private static final String TAG = "WebauthnCredManBridge";
+
+    /** Owner of the bridge should implement this interface and cache the bridge. */
+    public interface Provider {
+        WebauthnCredManBridge getCredManBridge();
+    }
+
+    public void onCredManConditionalRequestPending(
+            @Nullable RenderFrameHost frameHost,
+            boolean hasResults,
+            Callback<Boolean> fullAssertion) {
+        log(TAG, "onCredManConditionalRequestPending with hasResults: %b", hasResults);
+        WebauthnCredManBridgeJni.get()
+                .onCredManConditionalRequestPending(frameHost, hasResults, fullAssertion);
+    }
+
+    public void onCredManUiClosed(@Nullable RenderFrameHost frameHost, boolean success) {
+        log(TAG, "onCredManUiClosed with success: %b", success);
+        WebauthnCredManBridgeJni.get().onCredManUiClosed(frameHost, success);
+    }
+
+    public void onPasswordCredentialReceived(
+            @Nullable RenderFrameHost frameHost,
+            @Nullable String username,
+            @Nullable String password) {
+        log(TAG, "onPasswordCredentialReceived");
+        WebauthnCredManBridgeJni.get().onPasswordCredentialReceived(frameHost, username, password);
+    }
+
+    public void cleanupCredManRequest(@Nullable RenderFrameHost frameHost) {
+        log(TAG, "cleanupCredManRequest");
+        WebauthnCredManBridgeJni.get().cleanupCredManRequest(frameHost);
+    }
+
+    @NativeMethods
+    public interface Natives {
+        // Native methods are implemented in webauthn_cred_man_bridge.cc.
+        void onCredManConditionalRequestPending(
+                @Nullable RenderFrameHost frameHost,
+                boolean hasResults,
+                Callback<Boolean> fullAssertion);
+
+        void onCredManUiClosed(@Nullable RenderFrameHost frameHost, boolean success);
+
+        void onPasswordCredentialReceived(
+                @Nullable RenderFrameHost frameHost,
+                @Nullable String username,
+                @Nullable String password);
+
+        void cleanupCredManRequest(@Nullable RenderFrameHost frameHost);
+    }
+}
